# On the simulator use http://localhost:8000; a physical iPhone needs the Mac's LAN address.
BACKEND_URL=http://localhost:8000

# Matches INTERNALIZATION_ROOM_API_KEY on the backend (docker-compose defaults to sala-local-dev).
INTERNALIZATION_ROOM_KEY=
# Dev shortcuts, debug builds only: the skip bar, the phase jumps, and standing in for the
# device claim so the room opens without a facilitator linking the tablet from the Desk.
# A release build on a developer's own device asks for them on the command line instead —
# --dart-define=DEV_ATALHOS=true, which no stray .env can supply. See docs/setup.md.
DEV_PULAR_FASES=0
