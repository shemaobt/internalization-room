# On the simulator use http://localhost:8000; a physical iPhone needs the Mac's LAN address.
BACKEND_URL=http://localhost:8000


# Dev shortcuts, debug builds only: the skip bar and the phase jumps. The tablet is still
# linked from the Desk like any other. A release build on a developer's own device asks
# for the bar on the command line too — --dart-define=DEV_ATALHOS=true, which no stray
# .env can supply. See docs/setup.md.
DEV_PULAR_FASES=0
